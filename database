-- Création de la base de données
CREATE DATABASE IF NOT EXISTS `web4all` DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
USE `web4all`;
 
-- 1. Table des Rôles
CREATE TABLE `roles` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `nom` varchar(50) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB;
 
-- Insertion des 3 rôles de base
INSERT INTO `roles` (`nom`) VALUES ('Admin'), ('Pilote'), ('Etudiant');
 
-- 2. Table des Utilisateurs
CREATE TABLE `utilisateurs` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `nom` varchar(100) NOT NULL,
  `prenom` varchar(100) NOT NULL,
  `email` varchar(150) NOT NULL UNIQUE,
  `mot_de_passe` varchar(255) NOT NULL,
  `id_role` int(11) NOT NULL,
  PRIMARY KEY (`id`),
  FOREIGN KEY (`id_role`) REFERENCES `roles`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB;
 
-- 3. Table des Entreprises
CREATE TABLE `entreprises` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `nom` varchar(150) NOT NULL,
  `description` text,
  `email_contact` varchar(150),
  `telephone` varchar(20),
  PRIMARY KEY (`id`)
) ENGINE=InnoDB;
 
-- 4. Table des Offres
CREATE TABLE `offres` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `titre` varchar(200) NOT NULL,
  `description` text NOT NULL,
  `remuneration` decimal(10,2),
  `date_publication` date NOT NULL,
  `id_entreprise` int(11) NOT NULL,
  PRIMARY KEY (`id`),
  FOREIGN KEY (`id_entreprise`) REFERENCES `entreprises`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB;
 
-- 5. Table de la Wishlist (Favoris)
CREATE TABLE `wishlist` (
  `id_utilisateur` int(11) NOT NULL,
  `id_offre` int(11) NOT NULL,
  PRIMARY KEY (`id_utilisateur`, `id_offre`),
  FOREIGN KEY (`id_utilisateur`) REFERENCES `utilisateurs`(`id`) ON DELETE CASCADE,
  FOREIGN KEY (`id_offre`) REFERENCES `offres`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB;
 
-- 6. Table des Candidatures
CREATE TABLE `candidatures` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `id_utilisateur` int(11) NOT NULL,
  `id_offre` int(11) NOT NULL,
  `cv_path` varchar(255) NOT NULL,
  `lettre_motivation` text,
  `statut` varchar(50) DEFAULT 'En attente',
  `date_candidature` datetime DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  FOREIGN KEY (`id_utilisateur`) REFERENCES `utilisateurs`(`id`) ON DELETE CASCADE,
  FOREIGN KEY (`id_offre`) REFERENCES `offres`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB;
 
